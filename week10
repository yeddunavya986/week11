    {
      "cell_type": "code",
      "source": [
        "# ------------------------------------\n",
        "# Logic Problem\n",
        "# ------------------------------------\n",
        "\n",
        "problem = \"\"\"\n",
        "A farmer has 17 sheep.\n",
        "All but 9 die.\n",
        "How many sheep are left?\n",
        "\"\"\"\n",
        "\n",
        "# ------------------------------------\n",
        "# 1. Direct Answer (Baseline)\n",
        "# ------------------------------------\n",
        "\n",
        "baseline_prompt = f\"\"\"\n",
        "Answer the following question.\n",
        "\n",
        "{problem}\n",
        "\"\"\"\n",
        "\n",
        "baseline = client.chat.completions.create(\n",
        "    model=\"openai/gpt-oss-120b\",\n",
        "    messages=[{\"role\": \"user\", \"content\": baseline_prompt}]\n",
        ")\n",
        "\n",
        "# ------------------------------------\n",
        "# 2. Chain-of-Thought Prompt\n",
        "# ------------------------------------\n",
        "\n",
        "cot_prompt = f\"\"\"\n",
        "Solve the following problem.\n",
        "\n",
        "Let's think step by step and give a brief explanation before the final answer.\n",
        "\n",
        "{problem}\n",
        "\"\"\"\n",
        "\n",
        "cot = client.chat.completions.create(\n",
        "    model=\"openai/gpt-oss-120b\",\n",
        "    messages=[{\"role\": \"user\", \"content\": cot_prompt}]\n",
        ")\n",
        "\n",
        "# ------------------------------------\n",
        "# 3. Task Decomposition\n",
        "# ------------------------------------\n",
        "\n",
        "q1 = \"\"\"\n",
        "Question 1:\n",
        "How many sheep did the farmer have at the beginning?\n",
        "\"\"\"\n",
        "\n",
        "q2 = \"\"\"\n",
        "Question 2:\n",
        "What does 'All but 9 die' mean?\n",
        "\"\"\"\n",
        "\n",
        "q3 = \"\"\"\n",
        "Question 3:\n",
        "Based on the above answer, how many sheep are left?\n",
        "\"\"\"\n",
        "\n",
        "ans1 = client.chat.completions.create(\n",
        "    model=\"openai/gpt-oss-120b\",\n",
        "    messages=[{\"role\": \"user\", \"content\": q1}]\n",
        ")\n",
        "\n",
        "ans2 = client.chat.completions.create(\n",
        "    model=\"openai/gpt-oss-120b\",\n",
        "    messages=[{\"role\": \"user\", \"content\": q2}]\n",
        ")\n",
        "\n",
        "ans3 = client.chat.completions.create(\n",
        "    model=\"openai/gpt-oss-120b\",\n",
        "    messages=[{\"role\": \"user\", \"content\": q3}]\n",
        ")\n",
        "\n",
        "# ------------------------------------\n",
        "# Display Results\n",
        "# ------------------------------------\n",
        "\n",
        "print(\"========== Problem ==========\")\n",
        "print(problem)\n",
        "\n",
        "print(\"\\n========== Direct Answer ==========\")\n",
        "print(baseline.choices[0].message.content)\n",
        "\n",
        "print(\"\\n========== Chain-of-Thought ==========\")\n",
        "print(cot.choices[0].message.content)\n",
        "\n",
        "print(\"\\n========== Task Decomposition ==========\")\n",
        "\n",
        "print(\"\\nQuestion 1:\")\n",
        "print(ans1.choices[0].message.content)\n",
        "\n",
        "print(\"\\nQuestion 2:\")\n",
        "print(ans2.choices[0].message.content)\n",
        "\n",
        "print(\"\\nQuestion 3:\")\n",
        "print(ans3.choices[0].message.content)\n"
      ],
